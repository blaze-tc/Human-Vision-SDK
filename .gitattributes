* text=auto

.gitattributes text eol=lf
.gitignore text eol=lf
*.cs text eol=lf
*.asmdef text eol=lf
*.shader text eol=lf
*.c text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
*.json text eol=lf
*.md text eol=lf whitespace=-blank-at-eol

# Preserve byte-pinned ncnn patch context and device-probe evidence exactly.
third_party/ncnn/patches/0002-honor-subgroup-option.patch text eol=lf whitespace=-blank-at-eol
tools/models/ncnn/first_norm_probe.cpp whitespace=-blank-at-eof

*.docx binary
*.zip binary

# UPM archives and the Git install must have byte-identical manifest payloads.
upm/** -text whitespace=cr-at-eol
upm/**/Licenses/** whitespace=cr-at-eol,-blank-at-eol

# Frozen rectangle960 device evidence binds these exact reviewed CRLF bytes.
tools/models/ncnn/yolo_rectangle960_gate_evidence.json -text whitespace=cr-at-eol
tools/models/ncnn/yolo_rectangle960_golden_runner.cpp -text whitespace=cr-at-eol
tools/models/ncnn/yolo_rectangle960_runner/CMakeLists.txt -text whitespace=cr-at-eol
